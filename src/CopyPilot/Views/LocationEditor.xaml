<UserControl x:Class="CopyPilot.Views.LocationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CopyPilot.ViewModels"
             xmlns:v="clr-namespace:CopyPilot.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocationViewModel}"
             d:DesignWidth="450">
    <Border Style="{StaticResource Card}" Margin="0">
        <StackPanel>
            <TextBlock Text="{Binding Header}" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{x:Static vm:LocationViewModel.Kinds}" SelectedItem="{Binding SelectedKind}" />

            <!-- Local path or pipe file -->
            <StackPanel Visibility="{Binding UsesLocalPath, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LocalPathLabel}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="File…" Margin="6,0,0,0" Command="{Binding BrowseFileCommand}" />
                    <Button Grid.Column="2" Content="Folder…" Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}"
                            Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>

            <!-- Azure account -->
            <Grid Visibility="{Binding IsAzure, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Storage account" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" ToolTip="The storage account name, e.g. mystorageaccount" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cloud / endpoint suffix" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True" ItemsSource="{x:Static vm:LocationViewModel.EndpointSuffixes}"
                              Text="{Binding EndpointSuffix, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="core.windows.net (public), core.chinacloudapi.cn (China), core.usgovcloudapi.net (US Gov) or a custom suffix" />
                </StackPanel>
            </Grid>

            <!-- S3 region -->
            <StackPanel Visibility="{Binding IsS3, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Region (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. eu-west-1. Empty uses the global s3.amazonaws.com endpoint." />
            </StackPanel>

            <!-- Container / bucket and path -->
            <StackPanel Visibility="{Binding HasContainer, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ContainerLabel}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Container, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ContainerHint}" Style="{StaticResource Hint}" />
                <TextBlock Text="Path inside (optional, wildcards * allowed)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. folder/sub/*.csv or folder/file.txt" />
            </StackPanel>

            <!-- SAS -->
            <StackPanel Visibility="{Binding IsAzure, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SAS token (optional)" Style="{StaticResource FieldLabel}" />
                <PasswordBox v:PasswordBoxAssistant.BoundPassword="{Binding Sas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Shared access signature, e.g. sv=2024-...&amp;sig=... (with or without leading ?)" />
            </StackPanel>

            <!-- SFTP -->
            <StackPanel Visibility="{Binding IsSftp, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="Host name or IP address, e.g. sftp.example.com" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password (or leave empty and use a key)" Style="{StaticResource FieldLabel}" />
                <PasswordBox v:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Private key file (optional)" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="OpenSSH (id_ed25519, id_rsa), PEM or PuTTY .ppk key" />
                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseKeyCommand}" />
                </Grid>
                <TextBlock Text="Key passphrase (if the key is encrypted)" Style="{StaticResource FieldLabel}" />
                <PasswordBox v:PasswordBoxAssistant.BoundPassword="{Binding PrivateKeyPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Remote path" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}"
                         ToolTip="e.g. /home/arnold/data, data/*.csv (relative to the home folder) or /upload/file.zip" />
                <TextBlock Text="Host key fingerprint (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding HostKeyFingerprint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}"
                         ToolTip="SHA256:... as shown by 'ssh-keygen -lf'. Empty: the key is trusted on first connect and remembered; a changed key is refused." />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Empty: the server's key is trusted on first connect and remembered; if it changes later, the connection is refused." />
            </StackPanel>

            <!-- Custom URL -->
            <StackPanel Visibility="{Binding IsCustomUrl, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="URL" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" TextWrapping="Wrap"
                         ToolTip="Any URL azcopy understands, e.g. https://account.blob.core.windows.net/container/path?sv=...&amp;sig=..." />
            </StackPanel>

            <TextBlock Text="{Binding AuthHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Visibility="{Binding AuthHint, Converter={StaticResource EmptyToCollapsed}}" />

            <TextBlock Text="azcopy receives" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MonoTextBox}"
                     Background="{StaticResource WindowBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
